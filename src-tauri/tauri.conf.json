{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "walkie-songie",
  "version": "0.1.0",
  "identifier": "xyz.wondering.walkie-songie",
  "build": {
    "beforeDevCommand": "trunk serve --port 1420 --features web-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release --features web-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "walkie-songie",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Peer-to-peer collaborative music",
    "longDescription": "A direct-first Iroh collaborative music room with native MIDI."
  }
}
